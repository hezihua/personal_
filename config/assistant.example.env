# Pi / 模型（与 Pi CLI 相同，通常已在 ~/.pi/agent 配置）
# OPENAI_API_KEY=...

# 网关
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8787

# 飞书应用
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=your-verification-token

# 审批通知发到此会话（私聊机器人后从事件日志复制 chat_id）
HARNESS_FEISHU_CHAT_ID=oc_xxxxxxxx

# 本地 CLI 调试：非 TTY 时自动批准 ask
# HARNESS_AUTO_APPROVE=1
